# ============================================================
# Fsociety Bot — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Porta do painel web (Koyeb define automaticamente via PORT)
PORT=3000

# Senha de acesso ao painel (TROQUE para algo seguro!)
PANEL_PASSWORD=minha-senha-aqui

# Chave secreta da sessão (coloque qualquer frase longa e aleatória)
SESSION_SECRET=troque-esta-chave-por-algo-longo-e-aleatorio

# Ambiente
NODE_ENV=production

# --- Variáveis originais do bot ---
INTERNAL_WEBHOOK_TOKEN=coloque-um-token-longo-e-unico
INTERNAL_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1
PAIRING_MODE=code
PAIRING_NUMBER=5511999999999
LOG_COMMAND_EXECUTIONS=true
STRUCTURED_LOG_ENABLED=true
CONSOLE_LIVE_TELEMETRY=false
